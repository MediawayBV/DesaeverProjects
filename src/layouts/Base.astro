---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getDict, type Locale } from "../i18n/t";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDict(locale);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const businessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: "Desaever Projects",
  description: t.meta.description,
  url: `${Astro.site}${base}/`.replace(/([^:])\/\//g, "$1/"),
  // TODO: replace with real values
  telephone: "TODO",
  email: "TODO",
  address: {
    "@type": "PostalAddress",
    addressCountry: "BE",
  },
  areaServed: "BE",
};
---

<!doctype html>
<html lang={locale === "nl" ? "nl-BE" : "en"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}/img/logo/mark.png`} />

    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />

    <link rel="alternate" hreflang="nl" href={`${Astro.site}${base}/`} />
    <link rel="alternate" hreflang="en" href={`${Astro.site}${base}/en/`} />
    <link rel="alternate" hreflang="x-default" href={`${Astro.site}${base}/`} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:locale" content={locale === "nl" ? "nl_BE" : "en"} />
    <meta property="og:image" content={`${Astro.site}${base}/og-image.jpg`} />
    <meta name="twitter:card" content="summary_large_image" />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(businessSchema)}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    <Header locale={locale} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />

    <script>
      const io =
        "IntersectionObserver" in window
          ? new IntersectionObserver(
              (entries) => {
                for (const e of entries) {
                  if (e.isIntersecting) {
                    e.target.classList.add("is-visible");
                    io?.unobserve(e.target);
                  }
                }
              },
              { rootMargin: "0px 0px -10% 0px", threshold: 0.05 }
            )
          : null;
      document.querySelectorAll(".reveal").forEach((el) => {
        if (io) io.observe(el);
        else el.classList.add("is-visible");
      });
    </script>
  </body>
</html>
