---
import { Icon } from "astro-icon/components";
import { getDict, type Locale } from "../i18n/t";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getDict(locale);

const items = [
  { icon: "lucide:clock", label: t.trust.fast },
  { icon: "lucide:hammer", label: t.trust.craft },
  { icon: "lucide:message-circle", label: t.trust.clear },
  { icon: "lucide:users", label: t.trust.audience },
];
---

<section class="trust" aria-label="Trust">
  <div class="container trust__grid">
    {
      items.map((item) => (
        <div class="trust__item">
          <Icon name={item.icon} class="trust__icon" />
          <span>{item.label}</span>
        </div>
      ))
    }
  </div>
</section>

<style>
  .trust {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
    padding-block: 1.5rem;
  }
  .trust__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem 1.5rem;
  }
  .trust__item {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: var(--fs-14);
    font-weight: var(--fw-semibold);
    color: var(--color-fg);
  }
  .trust__icon {
    width: 18px;
    height: 18px;
    color: var(--color-accent);
    flex: 0 0 auto;
  }

  @media (min-width: 760px) {
    .trust__grid {
      grid-template-columns: repeat(4, 1fr);
      align-items: center;
    }
    .trust {
      padding-block: 1.25rem;
    }
  }
</style>
