---
import { getDict, localeUrl, type Locale } from "../i18n/t";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getDict(locale);
const home = localeUrl(locale);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const year = new Date().getFullYear();

const services = [
  t.services.items.pressure.title,
  t.services.items.gutter.title,
  t.services.items.handy.title,
  t.services.items.paint.title,
  t.services.items.maintenance.title,
  t.services.items.outdoor.title,
  t.services.items.renovation.title,
  t.services.items.build.title,
];
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <a href={home} aria-label="Desaever Projects">
        <img
          src={`${base}/img/logo/wordmark-light.svg`}
          alt="Desaever Projects"
          class="site-footer__wordmark"
          onerror="this.onerror=null;this.src=this.src.replace('-light','');this.classList.add('inverted');"
        />
      </a>
      <p class="site-footer__tagline">{t.footer.tagline}</p>
    </div>

    <div class="site-footer__col">
      <h3>{t.footer.services_title}</h3>
      <ul>
        {services.map((s) => <li><a href="#diensten">{s}</a></li>)}
      </ul>
    </div>

    <div class="site-footer__col">
      <h3>{t.footer.contact_title}</h3>
      <ul>
        <li><a href="#contact">{t.contact.phone_value}</a></li>
        <li><a href="#contact">{t.contact.email_value}</a></li>
        <li>{t.contact.region_value}</li>
      </ul>
    </div>
  </div>

  <div class="container site-footer__bar">
    <span>© {year} Desaever Projects · {t.footer.rights}</span>
    <span class="site-footer__group">{t.footer.group}</span>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-dark);
    color: var(--color-on-dark);
    padding-top: clamp(3rem, 6vw, 4.5rem);
    padding-bottom: 1.5rem;
  }
  .site-footer__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }
  .site-footer__brand p {
    color: var(--color-on-dark-muted);
    margin-top: 0.75rem;
    font-size: var(--fs-14);
  }
  .site-footer__wordmark {
    height: 32px;
    width: auto;
    /* If only the dark-on-light logo exists, invert it for dark footer */
  }
  .site-footer__wordmark.inverted {
    filter: invert(1) brightness(2);
  }
  .site-footer__col h3 {
    font-size: var(--fs-14);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin-bottom: 1rem;
    color: var(--color-on-dark);
  }
  .site-footer__col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }
  .site-footer__col a,
  .site-footer__col li {
    color: var(--color-on-dark-muted);
    font-size: var(--fs-14);
  }
  .site-footer__col a:hover {
    color: var(--color-on-dark);
  }
  .site-footer__bar {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgb(255 255 255 / 0.1);
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: space-between;
    color: var(--color-on-dark-muted);
    font-size: var(--fs-12);
  }
  .site-footer__group {
    letter-spacing: 0.04em;
  }

  @media (min-width: 760px) {
    .site-footer__grid {
      grid-template-columns: 1.4fr 1fr 1fr;
      gap: 3rem;
    }
  }
</style>
