---
interface Props {
  before: string;
  after: string;
  caption: string;
  beforeLabel: string;
  afterLabel: string;
  sliderLabel: string;
}
const { before, after, caption, beforeLabel, afterLabel, sliderLabel } =
  Astro.props;
---

<figure class="project-tile" data-tile>
  <div class="project-tile__viewport">
    <img class="project-tile__img project-tile__img--after" src={after} alt={`${caption} — ${afterLabel}`} loading="lazy" />
    <div class="project-tile__before" data-before>
      <img class="project-tile__img" src={before} alt={`${caption} — ${beforeLabel}`} loading="lazy" />
    </div>
    <span class="project-tile__tag project-tile__tag--before">{beforeLabel}</span>
    <span class="project-tile__tag project-tile__tag--after">{afterLabel}</span>
    <input
      type="range"
      min="0"
      max="100"
      value="50"
      class="project-tile__range"
      aria-label={sliderLabel}
      data-range
    />
    <div class="project-tile__handle" aria-hidden="true" data-handle>
      <span></span>
    </div>
  </div>
  <figcaption class="project-tile__caption">{caption}</figcaption>
</figure>

<style>
  .project-tile {
    margin: 0;
  }
  .project-tile__viewport {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-surface);
    user-select: none;
  }
  .project-tile__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .project-tile__before {
    position: absolute;
    inset: 0;
    width: 50%;
    overflow: hidden;
    will-change: width;
  }
  .project-tile__before .project-tile__img {
    width: calc(100% / 0.5); /* will be overridden via inline width */
  }
  .project-tile__tag {
    position: absolute;
    top: 0.75rem;
    padding: 0.25rem 0.625rem;
    font-size: var(--fs-12);
    font-weight: var(--fw-semibold);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border-radius: var(--radius-sm);
    background: rgb(0 0 0 / 0.6);
    color: #fff;
    backdrop-filter: blur(4px);
  }
  .project-tile__tag--before {
    left: 0.75rem;
  }
  .project-tile__tag--after {
    right: 0.75rem;
  }
  .project-tile__range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    appearance: none;
    background: transparent;
    cursor: ew-resize;
    z-index: 3;
  }
  .project-tile__range::-webkit-slider-thumb {
    appearance: none;
    width: 100%;
    height: 100%;
    background: transparent;
  }
  .project-tile__range::-moz-range-thumb {
    width: 100%;
    height: 100%;
    background: transparent;
    border: 0;
  }
  .project-tile__range:focus-visible + .project-tile__handle span {
    box-shadow: 0 0 0 4px rgb(227 6 19 / 0.4);
  }
  .project-tile__handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 2px;
    background: #fff;
    transform: translateX(-50%);
    pointer-events: none;
    z-index: 2;
  }
  .project-tile__handle span {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 36px;
    height: 36px;
    border-radius: 999px;
    background: #fff;
    box-shadow: 0 4px 12px rgb(0 0 0 / 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .project-tile__handle span::before,
  .project-tile__handle span::after {
    content: "";
    width: 0;
    height: 0;
    border-top: 5px solid transparent;
    border-bottom: 5px solid transparent;
  }
  .project-tile__handle span::before {
    border-right: 6px solid var(--color-fg);
    margin-right: 2px;
  }
  .project-tile__handle span::after {
    border-left: 6px solid var(--color-fg);
    margin-left: 2px;
  }
  .project-tile__caption {
    margin-top: 0.875rem;
    font-size: var(--fs-14);
    font-weight: var(--fw-semibold);
    color: var(--color-fg);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-tile]").forEach((tile) => {
    const range = tile.querySelector<HTMLInputElement>("[data-range]");
    const before = tile.querySelector<HTMLElement>("[data-before]");
    const handle = tile.querySelector<HTMLElement>("[data-handle]");
    const beforeImg = before?.querySelector<HTMLElement>(".project-tile__img");
    if (!range || !before || !handle || !beforeImg) return;

    const apply = (v: number) => {
      const pct = Math.max(0, Math.min(100, v));
      before.style.width = `${pct}%`;
      handle.style.left = `${pct}%`;
      // Keep the underlying image at its natural aspect by inverting the clip width
      beforeImg.style.width = `${(100 / Math.max(pct, 0.0001)) * 100}%`;
    };
    apply(Number(range.value));
    range.addEventListener("input", () => apply(Number(range.value)));
  });
</script>
