---
import { getDict, type Locale } from "../i18n/t";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getDict(locale);

const formspreeId = import.meta.env.PUBLIC_FORMSPREE_ID || "TODO_FORMSPREE_ID";
const action = `https://formspree.io/f/${formspreeId}`;

const f = t.contact.form;
const types = f.type_options;
---

<form
  class="contact-form"
  action={action}
  method="POST"
  data-form
  novalidate
>
  <input type="hidden" name="_subject" value="Nieuwe offerte-aanvraag · Desaever Projects" />
  <input type="hidden" name="_language" value={locale} />
  <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="contact-form__honeypot" aria-hidden="true" />

  <div class="contact-form__row">
    <div class="field">
      <label for="cf-name">{f.name} <span aria-hidden="true">*</span></label>
      <input id="cf-name" name="name" type="text" required autocomplete="name" />
    </div>
    <div class="field">
      <label for="cf-phone">{f.phone} <span aria-hidden="true">*</span></label>
      <input id="cf-phone" name="phone" type="tel" required autocomplete="tel" inputmode="tel" />
    </div>
  </div>

  <div class="contact-form__row">
    <div class="field">
      <label for="cf-email">{f.email} <span aria-hidden="true">*</span></label>
      <input id="cf-email" name="email" type="email" required autocomplete="email" />
    </div>
    <div class="field">
      <label for="cf-type">{f.type}</label>
      <select id="cf-type" name="type">
        <option value="">{f.type_placeholder}</option>
        <option value="handy">{types.handy}</option>
        <option value="renovation">{types.renovation}</option>
        <option value="bathroom">{types.bathroom}</option>
        <option value="kitchen">{types.kitchen}</option>
        <option value="maintenance">{types.maintenance}</option>
        <option value="build">{types.build}</option>
        <option value="other">{types.other}</option>
      </select>
    </div>
  </div>

  <div class="field">
    <label for="cf-message">{f.message} <span aria-hidden="true">*</span></label>
    <textarea id="cf-message" name="message" rows="5" required placeholder={f.message_placeholder}></textarea>
  </div>

  <button type="submit" class="btn btn-primary contact-form__submit" data-submit>
    <span data-submit-label>{f.submit}</span>
  </button>

  <p class="contact-form__error" data-error hidden role="alert">{f.error}</p>

  <div class="contact-form__success" data-success hidden role="status" aria-live="polite">
    <h3>{f.success_title}</h3>
    <p>{f.success_body}</p>
  </div>
</form>

<style>
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .contact-form__row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  @media (min-width: 640px) {
    .contact-form__row {
      grid-template-columns: 1fr 1fr;
    }
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .field label {
    font-size: var(--fs-14);
    font-weight: var(--fw-semibold);
    color: var(--color-fg);
  }
  .field input,
  .field select,
  .field textarea {
    width: 100%;
    padding: 0.75rem 0.875rem;
    font-size: var(--fs-16);
    color: var(--color-fg);
    background: var(--color-bg);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius);
    transition: border-color var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }
  .field textarea {
    resize: vertical;
    min-height: 120px;
  }
  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--color-fg);
    box-shadow: 0 0 0 3px rgb(10 10 10 / 0.08);
  }
  .field input:user-invalid,
  .field textarea:user-invalid {
    border-color: var(--color-accent);
  }

  .contact-form__honeypot {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .contact-form__submit {
    align-self: flex-start;
    margin-top: 0.25rem;
    padding: 0.9rem 1.5rem;
  }

  .contact-form__error {
    color: var(--color-accent);
    font-size: var(--fs-14);
    font-weight: var(--fw-semibold);
  }

  .contact-form__success {
    background: var(--color-accent-soft);
    border: 1px solid var(--color-accent);
    color: var(--color-fg);
    padding: 1.25rem 1.25rem;
    border-radius: var(--radius);
  }
  .contact-form__success h3 {
    font-size: var(--fs-18);
    margin: 0 0 0.25rem;
    color: var(--color-accent);
  }
  .contact-form__success p {
    color: var(--color-fg);
    font-size: var(--fs-14);
  }
</style>

<script define:vars={{ sending: f.sending }}>
  const form = document.querySelector("[data-form]");
  if (form) {
    const submit = form.querySelector("[data-submit]");
    const submitLabel = form.querySelector("[data-submit-label]");
    const errorEl = form.querySelector("[data-error]");
    const successEl = form.querySelector("[data-success]");
    const originalLabel = submitLabel?.textContent ?? "";

    form.addEventListener("submit", async (event) => {
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      event.preventDefault();
      errorEl.hidden = true;
      submit.disabled = true;
      submitLabel.textContent = sending;

      try {
        const data = new FormData(form);
        const res = await fetch(form.action, {
          method: "POST",
          body: data,
          headers: { Accept: "application/json" },
        });
        if (res.ok) {
          form.reset();
          successEl.hidden = false;
          form
            .querySelectorAll("input, select, textarea, button")
            .forEach((el) => {
              if (el.getAttribute("type") !== "hidden") el.disabled = true;
            });
          successEl.scrollIntoView({ behavior: "smooth", block: "center" });
        } else {
          throw new Error("submit-failed");
        }
      } catch {
        errorEl.hidden = false;
        submit.disabled = false;
        submitLabel.textContent = originalLabel;
      }
    });
  }
</script>
