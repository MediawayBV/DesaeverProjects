---
import { getDict, localeUrl, otherLocale, type Locale } from "../i18n/t";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getDict(locale);
const target = otherLocale(locale);
const href = localeUrl(target);
const targetCode = target.toUpperCase();
const currentCode = locale.toUpperCase();
---

<a
  class="lang-toggle"
  href={href}
  hreflang={target}
  lang={target}
  aria-label={`${t.lang.label}: ${t.lang.switch_to}`}
  title={t.lang.switch_to}
>
  <span class="lang-toggle__current">{currentCode}</span>
  <span class="lang-toggle__sep" aria-hidden="true">/</span>
  <span class="lang-toggle__other">{targetCode}</span>
</a>

<style>
  .lang-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.5rem 0.625rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    font-size: var(--fs-12);
    font-weight: var(--fw-semibold);
    letter-spacing: 0.06em;
    color: var(--color-muted);
    transition: border-color var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }
  .lang-toggle:hover {
    border-color: var(--color-fg);
    color: var(--color-fg);
  }
  .lang-toggle__current {
    color: var(--color-fg);
  }
  .lang-toggle__sep {
    color: var(--color-border-strong);
  }
</style>
