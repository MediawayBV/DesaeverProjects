---
import { getDict, type Locale } from "../i18n/t";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getDict(locale);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<section class="hero" aria-labelledby="hero-title">
  <div
    class="hero__bg"
    style={`background-image: url(${base}/img/hero.svg)`}
    aria-hidden="true"
  >
  </div>
  <div class="hero__overlay" aria-hidden="true"></div>
  <div class="container hero__inner">
    <p class="hero__eyebrow">{t.hero.eyebrow}</p>
    <h1 id="hero-title" class="hero__title">{t.hero.title}</h1>
    <p class="hero__lead">{t.hero.lead}</p>
    <div class="hero__cta">
      <a href="#contact" class="btn btn-primary">{t.hero.cta_primary}</a>
      <a href="#diensten" class="btn btn-ghost-light">{t.hero.cta_secondary}</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: clamp(520px, 80vh, 760px);
    display: flex;
    align-items: center;
    color: #fff;
    overflow: hidden;
    isolation: isolate;
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    background-color: #1a1a1a;
    background-size: cover;
    background-position: center;
    z-index: -2;
  }
  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgb(0 0 0 / 0.55) 0%,
      rgb(0 0 0 / 0.45) 50%,
      rgb(0 0 0 / 0.65) 100%
    );
    z-index: -1;
  }
  .hero__inner {
    padding-block: clamp(5rem, 12vw, 8rem);
    max-width: 760px;
  }
  .hero__eyebrow {
    display: inline-block;
    font-size: var(--fs-12);
    font-weight: var(--fw-semibold);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #fff;
    border-left: 3px solid var(--color-accent);
    padding-left: 0.75rem;
    margin: 0 0 1.25rem;
  }
  .hero__title {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1.05;
    margin: 0 0 1.25rem;
  }
  .hero__lead {
    font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
    color: rgb(255 255 255 / 0.88);
    max-width: 56ch;
    margin: 0 0 2rem;
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
