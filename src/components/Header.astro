---
import { getDict, localeUrl, type Locale } from "../i18n/t";
import LangToggle from "./LangToggle.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getDict(locale);
const home = localeUrl(locale);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const navLinks = [
  { href: "#diensten", label: t.nav.services },
  { href: "#werken", label: t.nav.projects },
  { href: "#werkwijze", label: t.nav.process },
  { href: "#over", label: t.nav.about },
  { href: "#contact", label: t.nav.contact },
];
---

<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a href={home} class="site-header__brand" aria-label="Desaever Projects">
      <img
        src={`${base}/img/logo/wordmark.svg`}
        alt="Desaever Projects"
        class="site-header__wordmark"
        onerror="this.onerror=null;this.src=this.src.replace('.svg','.png');this.classList.add('fallback');"
      />
      <span class="site-header__brand-fallback">Desaever Projects</span>
    </a>

    <nav class="site-header__nav" aria-label="Primary">
      <ul>
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <LangToggle locale={locale} />
      <a href="#contact" class="btn btn-primary btn-sm site-header__cta">
        {t.nav.cta}
      </a>
      <button
        type="button"
        class="site-header__toggle"
        aria-expanded="false"
        aria-controls="mobile-nav"
        data-menu-toggle
      >
        <span class="sr-only">{t.nav.menu_open}</span>
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <div class="site-header__mobile" id="mobile-nav" data-mobile-nav hidden>
    <ul>
      {
        navLinks.map((link) => (
          <li>
            <a href={link.href} data-mobile-link>
              {link.label}
            </a>
          </li>
        ))
      }
      <li>
        <a href="#contact" class="btn btn-primary" data-mobile-link>
          {t.nav.cta}
        </a>
      </li>
    </ul>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgb(255 255 255 / 0.92);
    backdrop-filter: saturate(140%) blur(12px);
    -webkit-backdrop-filter: saturate(140%) blur(12px);
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur) var(--ease),
      background-color var(--dur) var(--ease);
  }
  .site-header[data-scrolled="true"] {
    border-bottom-color: var(--color-border);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: var(--header-h);
  }

  .site-header__brand {
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
  }
  .site-header__wordmark {
    height: 28px;
    width: auto;
  }
  .site-header__wordmark.fallback + .site-header__brand-fallback {
    display: none;
  }
  .site-header__brand-fallback {
    display: none;
    font-weight: var(--fw-bold);
    font-size: var(--fs-18);
    letter-spacing: -0.01em;
  }
  .site-header__wordmark[src=""] + .site-header__brand-fallback,
  .site-header__wordmark:not([src]) + .site-header__brand-fallback {
    display: inline;
  }

  .site-header__nav {
    flex: 1 1 auto;
    display: none;
  }
  .site-header__nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    justify-content: center;
    gap: 1.75rem;
  }
  .site-header__nav a {
    font-size: var(--fs-14);
    font-weight: var(--fw-semibold);
    color: var(--color-fg);
    padding: 0.5rem 0;
    position: relative;
  }
  .site-header__nav a::after {
    content: "";
    position: absolute;
    inset: auto 0 0 0;
    height: 2px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur) var(--ease);
  }
  .site-header__nav a:hover::after,
  .site-header__nav a:focus-visible::after {
    transform: scaleX(1);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex: 0 0 auto;
  }
  .site-header__cta {
    display: none;
  }

  .site-header__toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius);
    border: 1px solid var(--color-border);
    color: var(--color-fg);
  }
  .site-header__toggle:hover {
    background: var(--color-surface);
  }

  .site-header__mobile {
    border-top: 1px solid var(--color-border);
    background: var(--color-bg);
  }
  .site-header__mobile[hidden] {
    display: none;
  }
  .site-header__mobile ul {
    list-style: none;
    margin: 0;
    padding: 1rem var(--gutter);
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .site-header__mobile a {
    display: block;
    padding: 0.875rem 0;
    font-size: var(--fs-18);
    font-weight: var(--fw-semibold);
    border-bottom: 1px solid var(--color-border);
  }
  .site-header__mobile li:last-child a {
    border: 0;
    margin-top: 0.75rem;
  }
  .site-header__mobile .btn {
    width: 100%;
  }

  @media (min-width: 880px) {
    .site-header__nav {
      display: block;
    }
    .site-header__cta {
      display: inline-flex;
    }
    .site-header__toggle {
      display: none;
    }
    .site-header__mobile {
      display: none !important;
    }
    .site-header__wordmark {
      height: 32px;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");
  const onScroll = () => {
    if (!header) return;
    header.dataset.scrolled = window.scrollY > 8 ? "true" : "false";
  };
  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  const toggle = document.querySelector<HTMLButtonElement>(
    "[data-menu-toggle]"
  );
  const drawer = document.querySelector<HTMLElement>("[data-mobile-nav]");
  toggle?.addEventListener("click", () => {
    if (!drawer) return;
    const open = drawer.hasAttribute("hidden");
    if (open) {
      drawer.removeAttribute("hidden");
      toggle.setAttribute("aria-expanded", "true");
    } else {
      drawer.setAttribute("hidden", "");
      toggle.setAttribute("aria-expanded", "false");
    }
  });
  document.querySelectorAll<HTMLAnchorElement>("[data-mobile-link]").forEach(
    (a) =>
      a.addEventListener("click", () => {
        drawer?.setAttribute("hidden", "");
        toggle?.setAttribute("aria-expanded", "false");
      })
  );
</script>
