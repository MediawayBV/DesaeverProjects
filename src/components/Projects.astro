---
import { getDict, type Locale } from "../i18n/t";
import ProjectTile from "./ProjectTile.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getDict(locale);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const items = [
  {
    key: "p1",
    before: `${base}/img/projects/p1-before.svg`,
    after: `${base}/img/projects/p1-after.svg`,
    caption: t.projects.items.p1,
  },
  {
    key: "p2",
    before: `${base}/img/projects/p2-before.svg`,
    after: `${base}/img/projects/p2-after.svg`,
    caption: t.projects.items.p2,
  },
  {
    key: "p3",
    before: `${base}/img/projects/p3-before.svg`,
    after: `${base}/img/projects/p3-after.svg`,
    caption: t.projects.items.p3,
  },
  {
    key: "p4",
    before: `${base}/img/projects/p4-before.svg`,
    after: `${base}/img/projects/p4-after.svg`,
    caption: t.projects.items.p4,
  },
];
---

<section id="werken" class="section projects reveal" aria-labelledby="projects-title">
  <div class="container">
    <header class="section-head">
      <p class="eyebrow">{t.projects.eyebrow}</p>
      <h2 id="projects-title" class="section-title">{t.projects.title}</h2>
      <p class="section-lead">{t.projects.lead}</p>
    </header>

    <div class="projects__grid">
      {
        items.map((item) => (
          <ProjectTile
            before={item.before}
            after={item.after}
            caption={item.caption}
            beforeLabel={t.projects.before}
            afterLabel={t.projects.after}
            sliderLabel={t.projects.slider_label}
          />
        ))
      }
    </div>
  </div>
</section>

<style>
  .projects {
    background: var(--color-surface);
  }
  .projects__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 760px) {
    .projects__grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
  }
</style>
